# ---------------------------------------------------------------------------
# Ambiente virtual e dependências
# ---------------------------------------------------------------------------
# O .venv tem ~1,4 GB. Ele é reconstruído com `uv sync` a partir do uv.lock.
.venv/
venv/
env/
ENV/
.uv-cache/
.workflows/

# NÃO ignorar (devem ser versionados):
#   uv.lock          -> versões exatas; é o que garante ambiente idêntico
#   .python-version  -> versão do Python do projeto
#   pyproject.toml   -> declaração das dependências

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---------------------------------------------------------------------------
# Jupyter
# ---------------------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# ---------------------------------------------------------------------------
# Artefatos gerados pelos notebooks
# ---------------------------------------------------------------------------
# Modelos serializados nas etapas 6 dos três notebooks
*.joblib
*.pkl
*.pickle

# O CatBoost cria este diretório automaticamente a cada fit
catboost_info/

# Base rotulada exportada na etapa 6.6 do notebook 03
base_segmentada.parquet

# Bancos de estudo do Optuna (extra "tuning")
*.db
optuna_study*/

# Gráficos exportados
*.png
*.jpg
*.jpeg
*.svg
*.pdf

# ---------------------------------------------------------------------------
# Dados
# ---------------------------------------------------------------------------
# Os notebooks usam dados fictícios gerados em memória. Se você apontar o
# read_csv para dados reais, mantenha-os aqui — fora do controle de versão.
dados/
data/
datasets/
*.csv
*.tsv
*.xlsx
*.xls
*.parquet
*.feather
*.h5
*.hdf5

# Para versionar um arquivo específico apesar das regras acima:
#   git add -f exemplo.csv
# Ou libere um caminho fixo descomentando a linha abaixo:
# !exemplos/amostra.csv

# ---------------------------------------------------------------------------
# Segredos e configuração local
# ---------------------------------------------------------------------------
.env
.env.*
*.key
*.pem
credentials.json

# Configuração local do Claude Code (específica desta máquina)
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Editores e sistema operacional
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
